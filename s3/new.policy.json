{
  "Id": "PublicSharePolicy",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": ["s3:GetObject"],
      "Effect": "Allow",
      "Resource": ["arn:aws:s3:::kyaaa.net/*"],
      "Condition": {
        "StringLike": {
          "aws:Referer": [
            "https://ia.kyaaa.net*",
            "http://ia.kyaaa.net*",
            "https://ia-kyaaa-net.caprover.stivenlovera.dev*",
            "http://ia-kyaaa-net.caprover.stivenlovera.dev*",
            "http://localhost:3000*",
            "http://192.168.1.135:3000*"
          ]
        }
      },
      "Principal": "*"
    }
  ]
}
