// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

model Pack_State {
  pack_state_id Int       @id @default(autoincrement())
  name          String
  create_at     DateTime?
  update_at     DateTime?
  packs         Pack[]

  @@map(name: "pack_state")
}

model Pack {
  pack_id           Int                @id @default(autoincrement())
  name              String
  description       String
  code              String
  active            Int
  create_at         DateTime?
  update_at         DateTime?
  pages             Page[]
  pack_types        Pack_type[]
  pack_character    Pack_character[]
  pack_label        Pack_label[]
  pack_serie        Pack_serie[]
  pack_authors      Pack_author[]
  pack_languages    Pack_language[]
  participate_packs Participate_Pack[]
  pack_state        Pack_State         @relation(fields: [pack_state_id], references: [pack_state_id])
  pack_state_id     Int
  buyPacks          Buy_Pack[]
  favoritePacks     Favorite_Pack[]
  likePacks         Like_Pack[]

  @@map(name: "pack")
}

model Page {
  page_id   Int         @id @default(autoincrement())
  pack      Pack        @relation(fields: [pack_id], references: [pack_id])
  page_size Page_size[]
  pack_id   Int
  num       String
  state     Int
  create_at DateTime?
  update_at DateTime?

  @@map(name: "page")
}

model Type {
  type_id    Int         @id @default(autoincrement())
  name       String
  state      Int
  pack_types Pack_type[]
  create_at  DateTime?
  update_at  DateTime?

  @@map(name: "type")
}

model Label {
  label_id    Int          @id @default(autoincrement())
  name        String
  state       Int
  create_at   DateTime?
  update_at   DateTime?
  pack_labels Pack_label[]

  @@map(name: "label")
}

model Character {
  character_id    Int              @id @default(autoincrement())
  name            String
  state           Int
  create_at       DateTime?
  update_at       DateTime?
  pack_characters Pack_character[]

  @@map(name: "character")
}

model Serie {
  serie_id    Int          @id @default(autoincrement())
  name        String
  pack_series Pack_serie[]
  state       Int
  create_at   DateTime?
  update_at   DateTime?

  @@map(name: "serie")
}

model Author {
  author_id    Int           @id @default(autoincrement())
  name         String
  pack_authors Pack_author[]
  state        Int
  create_at    DateTime?
  update_at    DateTime?

  @@map(name: "author")
}

model Language {
  language_id    Int             @id @default(autoincrement())
  name           String
  pack_languages Pack_language[]
  state          Int
  create_at      DateTime?
  update_at      DateTime?

  @@map(name: "language")
}

model Size {
  size_id   Int         @id @default(autoincrement())
  name      String
  extension String
  page_size Page_size[]
  state     Int
  create_at DateTime?
  update_at DateTime?

  @@map(name: "size")
}

model Page_size {
  size_id   Int
  size      Size      @relation(fields: [size_id], references: [size_id])
  page_id   Int
  page      Page      @relation(fields: [page_id], references: [page_id])
  create_at DateTime?
  update_at DateTime?

  @@id([size_id, page_id])
  @@map(name: "page_size")
}

model Pack_type {
  type      Type      @relation(fields: [type_id], references: [type_id])
  type_id   Int
  pack      Pack      @relation(fields: [pack_id], references: [pack_id])
  pack_id   Int
  create_at DateTime?
  update_at DateTime?

  @@id([pack_id, type_id])
  @@map(name: "pack_type")
}

model Pack_label {
  label_id  Int
  pack_id   Int
  create_at DateTime?
  update_at DateTime?
  pack      Pack      @relation(fields: [pack_id], references: [pack_id])
  label     Label     @relation(fields: [label_id], references: [label_id])

  @@id([label_id, pack_id])
  @@map(name: "pack_label")
}

model Pack_serie {
  serie_id  Int
  pack_id   Int
  create_at DateTime?
  update_at DateTime?
  serie     Serie     @relation(fields: [serie_id], references: [serie_id])
  pack      Pack      @relation(fields: [pack_id], references: [pack_id])

  @@id([serie_id, pack_id])
  @@map(name: "pack_serie")
}

model Pack_character {
  character_id Int
  character    Character @relation(fields: [character_id], references: [character_id])
  pack_id      Int
  pack         Pack      @relation(fields: [pack_id], references: [pack_id])
  create_at    DateTime?
  update_at    DateTime?

  @@id([character_id, pack_id])
  @@map(name: "pack_character")
}

model Pack_author {
  author_id Int
  author    Author    @relation(fields: [author_id], references: [author_id])
  pack_id   Int
  pack      Pack      @relation(fields: [pack_id], references: [pack_id])
  create_at DateTime?
  update_at DateTime?

  @@id([author_id, pack_id])
  @@map(name: "pack_author")
}

model Pack_language {
  language_id Int
  language    Language  @relation(fields: [language_id], references: [language_id])
  pack_id     Int
  pack        Pack      @relation(fields: [pack_id], references: [pack_id])
  create_at   DateTime?
  update_at   DateTime?

  @@id([language_id, pack_id])
  @@map(name: "pack_language")
}

model User {
  user_id        Int             @default(autoincrement())
  email          String          @unique
  name           String
  nick           String
  password       String
  verified_email DateTime?
  state          Int             @default(1)
  image          String
  create_at      DateTime        @default(now())
  update_at      DateTime        @updatedAt
  votes          Vote[]
  user_rols      User_Rol[]
  likePacks      Like_Pack[]
  favoritePacks  Favorite_Pack[]
  buyPacks       Buy_Pack[]

  @@id([user_id])
  @@map(name: "user")
}

model Rol {
  rol_id    Int        @default(autoincrement())
  name      String
  create_at DateTime   @default(now())
  update_at DateTime   @updatedAt
  user_rols User_Rol[]

  @@id([rol_id])
  @@map(name: "rol")
}

model User_Rol {
  rol       Rol      @relation(fields: [rol_id], references: [rol_id])
  rol_id    Int
  user      User     @relation(fields: [user_id], references: [user_id])
  user_id   Int
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  @@id([rol_id, user_id])
  @@map(name: "user_rol")
}

model State_Participate {
  state_participate_id Int           @default(autoincrement())
  name                 String
  create_at            DateTime      @default(now())
  update_at            DateTime      @updatedAt
  participates         Participate[]

  @@id([state_participate_id])
  @@map(name: "state_participate")
}

model Participate {
  participate_id       Int                @default(autoincrement())
  state_participate    State_Participate  @relation(fields: [state_participate_id], references: [state_participate_id])
  state_participate_id Int
  name                 String
  start_date           DateTime
  start_end            DateTime
  create_at            DateTime           @default(now())
  update_at            DateTime           @updatedAt
  participate_packs    Participate_Pack[]

  @@id([participate_id])
  @@map(name: "participate")
}

model Participate_Pack {
  participate_pack_id Int         @default(autoincrement())
  pack                Pack        @relation(fields: [pack_id], references: [pack_id])
  pack_id             Int
  participate         Participate @relation(fields: [participate_id], references: [participate_id])
  participate_id      Int
  create_at           DateTime    @default(now())
  update_at           DateTime    @updatedAt
  votes               Vote[]

  @@id([participate_pack_id])
  @@map(name: "participate_pack")
}

model Vote {
  participate_pack    Participate_Pack @relation(fields: [participate_pack_id], references: [participate_pack_id])
  participate_pack_id Int
  user                User             @relation(fields: [user_id], references: [user_id])
  user_id             Int
  create_at           DateTime         @default(now())
  update_at           DateTime         @updatedAt

  @@id([participate_pack_id, user_id])
  @@map(name: "vote")
}

model Buy_Pack {
  user      User     @relation(fields: [user_id], references: [user_id])
  user_id   Int
  pack      Pack     @relation(fields: [pack_id], references: [pack_id])
  pack_id   Int
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  @@id([user_id, pack_id])
  @@map(name: "buy_pack")
}

model Favorite_Pack {
  user      User     @relation(fields: [user_id], references: [user_id])
  user_id   Int
  pack      Pack     @relation(fields: [pack_id], references: [pack_id])
  pack_id   Int
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  @@id([user_id, pack_id])
  @@map(name: "favorite_pack")
}

model Like_Pack {
  user      User     @relation(fields: [user_id], references: [user_id])
  user_id   Int
  pack      Pack     @relation(fields: [pack_id], references: [pack_id])
  pack_id   Int
  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  @@id([user_id, pack_id])
  @@map(name: "like_pack")
}
