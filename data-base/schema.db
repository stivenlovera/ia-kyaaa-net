DROP DATABASE IF EXISTS `ia_kyaaa`;
CREATE DATABASE `ia_kyaaa` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

use `ia_kyaaa`;

DROP TABLE IF EXISTS type;
CREATE TABLE `type` (
  `type_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(512) NOT NULL,
  `slug` varchar(512) NOT NULL,
  `state` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS `label`;
CREATE TABLE `label` (
  `label_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(512) NOT NULL,
  `slug` varchar(512) NOT NULL,
  `state` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS serie;
CREATE TABLE `serie` (
  `serie_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(512) NOT NULL,
  `slug` varchar(512) NOT NULL,
  `state` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS `character` ;
CREATE TABLE `character` (
  `character_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(512) NOT NULL,
  `slug` varchar(512) NOT NULL,
  `state` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS `author` ;
CREATE TABLE `author` (
  `author_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(512) NOT NULL,
  `slug` varchar(512) NOT NULL,
  `state` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS `language` ;
CREATE TABLE `language` (
  `language_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(512) NOT NULL,
  `slug` varchar(512) NOT NULL,
  `state` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS `size` ;
CREATE TABLE `size` (
  `size_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(50) NOT NULL,
  `extension` varchar(10) NOT NULL,
  `state` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS pack_state;
CREATE TABLE `pack_state` (
  `pack_state_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(100) NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
);

DROP TABLE IF EXISTS pack;
CREATE TABLE `pack` (
  `pack_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(255) NOT NULL,
  `description` varchar(4500) default '' NOT NULL,
  `code` varchar(20) default '' NOT NULL,
  `price_list` decimal(10,2) default NOT NULL,
  `pack_state_id` int NOT NULL,
  `active` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`pack_state_id`) REFERENCES `pack_state`(`pack_state_id`)
);

DROP TABLE IF EXISTS pack_type;
CREATE TABLE `pack_type` (
  `type_id` int NOT NULL,
  `pack_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`type_id`) REFERENCES `type`(`type_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`)
);

DROP TABLE IF EXISTS pack_label;
CREATE TABLE `pack_label` (
  `label_id` int NOT NULL,
  `pack_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`label_id`) REFERENCES `label`(`label_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`)
);

DROP TABLE IF EXISTS pack_serie;
CREATE TABLE `pack_serie` (
  `serie_id` int NOT NULL,
  `pack_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`serie_id`) REFERENCES `serie`(`serie_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`)
);

DROP TABLE IF EXISTS `pack_character` ;
CREATE TABLE `pack_character` (
  `character_id` int NOT NULL,
  `pack_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`character_id`) REFERENCES `character`(`character_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`)
);

DROP TABLE IF EXISTS `pack_author` ;
CREATE TABLE `pack_author` (
  `author_id` int NOT NULL,
  `pack_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`author_id`) REFERENCES `author`(`author_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`)
);

DROP TABLE IF EXISTS `pack_language` ;
CREATE TABLE `pack_language` (
  `language_id` int NOT NULL,
  `pack_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`language_id`) REFERENCES `language`(`language_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`)
);

DROP TABLE IF EXISTS page_type;
CREATE TABLE `page_type` (
  `page_type_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(20) default '' NOT NULL,
  `state` tinyint NOT NULL DEFAULT 1,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS page;
CREATE TABLE `page` (
  `page_id` int NOT NULL auto_increment primary KEY,
  `pack_id` int NOT NULL,
  `code` varchar(100) default '' NOT NULL,
  `num` varchar(5) NOT NULL,
  `state` tinyint NOT NULL DEFAULT 1,
  `page_type_id` int NOT NULL
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`page_type_id`) REFERENCES `page_type`(`page_type_id`)
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`)
);

DROP TABLE IF EXISTS `page_size` ;
CREATE TABLE `page_size` (
  `page_id` int NOT NULL,
  `size_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`page_id`) REFERENCES `page`(`page_id`),
  FOREIGN KEY(`size_id`) REFERENCES `size`(`size_id`)
);

DROP TABLE IF EXISTS `user` ;
CREATE TABLE `user` (
  `user_id` int NOT NULL auto_increment primary KEY,
  `email` varchar(150) NOT NULL,
  `verified_email` datetime NULL,
  `name` varchar(250) NOT NULL,
  `nick` varchar(100) NOT NULL,
  `image` varchar(250) NULL,
  `password` text NOT NULL,
  `state` tinyint(1) default 1 NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS `rol` ;
CREATE TABLE `rol` (
  `rol_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(250) NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS `user_rol` ;
CREATE TABLE `user_rol` (
  `rol_id` int NOT NULL,
  `user_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`rol_id`) REFERENCES `rol`(`rol_id`),
  FOREIGN KEY(`user_id`) REFERENCES `user`(`user_id`)
);

DROP TABLE IF EXISTS `state_participate` ;
CREATE TABLE `state_participate` (
  `state_participate_id` int NOT NULL auto_increment primary KEY,
  `name` varchar(250) NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

DROP TABLE IF EXISTS `participate` ;
CREATE TABLE `participate` (
  `participate_id` int NOT NULL auto_increment primary KEY,
  `state_participate_id` int NOT NULL,
  `name` varchar(250) NOT NULL,
  `start_date` date NOT NULL,
  `start_end` date NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`state_participate_id`) REFERENCES `state_participate`(`state_participate_id`)
);

DROP TABLE IF EXISTS `participate_pack` ;
CREATE TABLE `participate_pack` (
  `participate_pack_id` int NOT NULL auto_increment primary KEY,
  `pack_id` int NOT NULL,
  `participate_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`),
  FOREIGN KEY(`participate_id`) REFERENCES `participate`(`participate_id`)
);

DROP TABLE IF EXISTS `vote` ;
CREATE TABLE `vote` (
  `participate_pack_id` int NOT NULL,
  `user_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`participate_pack_id`) REFERENCES `participate_pack`(`participate_pack_id`),
  FOREIGN KEY(`user_id`) REFERENCES `user`(`user_id`)
);

DROP TABLE IF EXISTS `method_buy` ;
CREATE TABLE `method_buy` (
  `method_buy_id` int NOT NULL auto_increment,
  `name` varchar(20) default '' NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`method_buy_id`)
);

DROP TABLE IF EXISTS `buy_pack` ;
CREATE TABLE `buy_pack` (
  `pack_id` int NOT NULL,
  `user_id` int NOT NULL,
  `method_buy_id` int NOT NULL,
  `price` decimal(10,2) NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`user_id`) REFERENCES `user`(`user_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`),
  FOREIGN KEY(`method_buy_id`) REFERENCES `method_buy`(`method_buy_id`),
  PRIMARY KEY (`pack_id`,`user_id`,`method_buy_id`)
);

DROP TABLE IF EXISTS `favorite_pack` ;
CREATE TABLE `favorite_pack` (
  `pack_id` int NOT NULL,
  `user_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`user_id`) REFERENCES `user`(`user_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`),
  PRIMARY KEY (`pack_id`,`user_id`)
);

DROP TABLE IF EXISTS `like_pack` ;
CREATE TABLE `like_pack` (
  `pack_id` int NOT NULL,
  `user_id` int NOT NULL,
  `create_at` datetime DEFAULT CURRENT_TIMESTAMP,
  `update_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  FOREIGN KEY(`user_id`) REFERENCES `user`(`user_id`),
  FOREIGN KEY(`pack_id`) REFERENCES `pack`(`pack_id`),
  PRIMARY KEY (pack_id, user_id)
);

